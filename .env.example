# ============================================================
# .env CENTRAL do monorepo — única fonte de verdade
# cp .env.example .env  →  preencha os segredos
# apps/api/.dev.vars é GERADO deste arquivo (scripts/sync-env.mjs)
# O Vite (apps/web) também lê este arquivo (envDir = raiz)
# ============================================================

# --- Segredos (api) ---
OPENROUTER_API_KEY=
# token opaco devolvido pelo /auth/login (repo pode ser público: o valor vive aqui, nunca no código).
# Gere com: openssl rand -hex 32
SESSION_TOKEN=
# login do app: credencial inicial user/123456. A 1ª sessão OBRIGA a trocar
# (POST /api/v1/auth/change-password com newPassword e/ou newUsername);
# usuário + hash da senha ficam no D1 (tabela auth_state) — não há segredo
# de auth no .env. Para resetar ao default em dev:
# DELETE FROM auth_state; (local ou --remote).

# --- Models / RAG (dev; produção usa wrangler.toml [vars]) ---
EMBED_MODEL=perplexity/pplx-embed-v1-0.6b
CHAT_MODEL_FAST=minimax/MiniMax-M3:free
CHAT_MODEL_CHEAP=z-ai/glm-5.3-flash
CHAT_MODEL_QUALITY=meta/muse-spark-1.3-contributor
RERANK_ENABLED=true
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RAG_TOPK=20
RERANK_TOPN=5
RAG_MIN_SCORE=0.5
SINGLE_USER_ID=me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Web (prefixo VITE_ é exposto ao browser — nada de segredos aqui) ---
# vazio = usa o proxy do Vite em dev (/api -> :8787). Em produção: URL completa.
VITE_API_URL=

# --- Mobile (Expo lê via apps/mobile/app.config.js a partir deste .env) ---
# Padrão = API de produção (https). Para dev local, sobrescreva na hora de subir:
# EXPO_PUBLIC_API_URL=http://<IP-LAN>:8787 pnpm --filter @meu-gpt/mobile dev
# (emulador Android: http://10.0.2.2:8787; env de processo tem precedência sobre este arquivo)
EXPO_PUBLIC_API_URL=
