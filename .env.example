# Único segredo real no MVP. Não commitar .dev.vars / .env
OPENROUTER_API_KEY=

# Embeddings — travo 1024 nativo, sem truncate
# id exato: perplexity/pplx-embed-v1-0.6b
EMBED_MODEL=perplexity/pplx-embed-v1-0.6b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vectorize — 1024 + cosine (não-normalizado, encoding float)
# npx wrangler vectorize create meu-gpt --dimensions=1024 --metric=cosine
VECTORIZE_INDEX=meu-gpt

# Chat — 3 slots, sem marca gravada no banco (só log por mensagem)
CHAT_MODEL_FAST=minimax/MiniMax-M3:free
CHAT_MODEL_CHEAP=meta-llama/llama-3.3-70b-instruct
CHAT_MODEL_QUALITY=anthropic/claude-haiku-4.5

# Rerank Voyage (flag desligada no MVP)
RERANK_ENABLED=false
RERANK_MODEL=voyageai/rerank-2.5
# qualidade futura: voyageai/rerank-3 / fast futuro: voyageai/rerank-3-lite
VOYAGE_API_KEY=
RERANK_TOPN=5
RAG_TOPK=20

# Auth single-user
JWT_SECRET=trocar-em-producao-com-openssl-rand-hex-32
SINGLE_USER_ID=me
# Se usar Cloudflare Access, valide o JWT do Access no Worker em vez do JWT próprio

# App
API_URL=http://localhost:8787
WEB_PORT=5173
