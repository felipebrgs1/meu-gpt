{
  "name": "meu-gpt",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "smoke:embed": "pnpm --filter @meu-gpt/rag smoke:embed",
