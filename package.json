    "cleanup:all": "node scripts/cleanup-conversations.mjs --all --yes"
  },
  "devDependencies": {
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "smol-toml": "^1.8.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.4"
}
